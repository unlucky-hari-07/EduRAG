# --- Option A: local Ollama (default) ---------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1
# No API key needed for a local install.

# --- Option B: Ollama Cloud (no local install needed) -----------------
# 1. Create a free account at https://ollama.com
# 2. Generate a key at https://ollama.com/settings/keys
# 3. Uncomment the three lines below and paste in your key.
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL_NAME=gpt-oss:20b
# OLLAMA_API_KEY=your_ollama_cloud_key_here

# Only needed by the frontend when NOT using docker-compose (which sets
# this automatically to point at the backend container).
BACKEND_URL=http://localhost:8000

# Optional tuning - safe to leave at defaults.
MAX_FILE_SIZE_BYTES=15728640
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATE_K=15
RERANK_TOP_K=5
MIN_CONTEXT_SCORE=0.15
MAX_GRAPH_ITERATIONS=2
